<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginBottom="8dp"
    android:addStatesFromChildren="true"
    android:background="@drawable/selector_site_item"
    android:descendantFocusability="afterDescendants"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="8dp">

    <View
        android:id="@+id/health"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/shape_site_health" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="15sp"
        tools:text="站点名称" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/shape_site_type"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="@color/white"
        android:textSize="12sp" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/toggle"
        android:layout_width="40dp"
        android:layout_height="36dp"
        android:background="@drawable/selector_dialog_switch"
        android:contentDescription="@string/setting_show"
        android:focusable="true"
        android:padding="8dp"
        android:scaleType="center"
        android:src="@drawable/ic_player_button_visible"
        app:tint="@color/white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/up"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="40dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/player_button_up"
        android:focusable="true"
        android:minWidth="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:textColor="@color/white"
        app:backgroundTint="@color/white_30"
        app:icon="@drawable/ic_player_button_up"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="18dp"
        app:iconTint="@color/white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/down"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="40dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/player_button_down"
        android:focusable="true"
        android:minWidth="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:textColor="@color/white"
        app:backgroundTint="@color/white_30"
        app:icon="@drawable/ic_player_button_down"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="18dp"
        app:iconTint="@color/white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/top"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="40dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/player_button_top"
        android:focusable="true"
        android:minWidth="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:textColor="@color/white"
        app:backgroundTint="@color/white_30"
        app:icon="@drawable/ic_player_button_top"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="18dp"
        app:iconTint="@color/white" />

</androidx.appcompat.widget.LinearLayoutCompat>
