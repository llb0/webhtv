<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <!-- 静态背景+边框，遥控器焦点常驻显示 -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp"/>
                    <solid android:color="#301A73E8"/>
                    <stroke android:width="2dp" android:color="#FF0000FF"/>
                    <padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp"/>
                </shape>
            </item>
            <!-- 波纹前景，按下触发 -->
            <item>
                <ripple android:color="#1F0B57D0">
                    <item android:id="@android:id/mask">
                        <shape android:shape="rectangle">
                            <corners android:radius="8dp"/>
                            <solid android:color="@color/white"/>
                        </shape>
                    </item>
                </ripple>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp"/>
                    <solid android:color="@android:color/transparent"/>
                    <stroke android:width="2dp" android:color="#FF666666"/>
                    <padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp"/>
                </shape>
            </item>
            <item>
                <ripple android:color="#1F0B57D0">
                    <item android:id="@android:id/mask">
                        <shape android:shape="rectangle">
                            <corners android:radius="8dp"/>
                            <solid android:color="@color/white"/>
                        </shape>
                    </item>
                </ripple>
            </item>
        </layer-list>
    </item>
</selector>
