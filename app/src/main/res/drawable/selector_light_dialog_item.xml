<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- TV遥控器获得焦点：蓝色加粗描边 -->
    <item android:state_focused="true">
        <ripple android:color="#1F0B57D0">
            <shape android:shape="rectangle">
                <corners android:radius="8dp" />
                <solid android:color="@color/dialog_outlined_button_bg" />
                <stroke
                    android:width="2dp"
                    android:color="#1A73E8" />
                <padding
                    android:bottom="8dp"
                    android:left="12dp"
                    android:right="12dp"
                    android:top="8dp" />
            </shape>
        </ripple>
    </item>

    <!-- 常态，原有样式，手机点击ripple保留 -->
    <item>
        <ripple android:color="#1F0B57D0">
            <shape android:shape="rectangle">
                <corners android:radius="8dp" />
                <solid android:color="@color/dialog_outlined_button_bg" />
                <stroke
                    android:width="1dp"
                    android:color="@color/dialog_outlined_button_stroke" />
                <padding
                    android:bottom="8dp"
                    android:left="12dp"
                    android:right="12dp"
                    android:top="8dp" />
            </shape>
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="@color/white" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
